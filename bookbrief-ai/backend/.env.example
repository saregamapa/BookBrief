# ============================================================
# BookBrief AI — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=BookBrief AI
DEBUG=false
# Long random string — used for general signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated allowed CORS origins (no trailing slash)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Database ─────────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL=sqlite:///./bookbrief.db
# PostgreSQL for production (Render sets DATABASE_URL automatically):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/bookbrief

# ── JWT Auth ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
# Token lifetime in minutes (default 7 days = 10080)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── OpenRouter (summaries, translation, podcast, TTS, video) ─
# Required in production.
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_SUMMARY_MODEL=google/gemma-4-26b-a4b-it
# Fast summarization (single LLM pass; target ~60s end-to-end)
# SUMMARY_MAX_INPUT_CHARS=28000
# SUMMARY_LLM_TIMEOUT_SECONDS=50
# SUMMARY_TARGET_SECONDS=60
# OPENROUTER_PODCAST_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts
# OPENROUTER_VIDEO_MODEL=google/veo-3.1-lite
# OPENROUTER_TTS_RESPONSE_FORMAT=mp3
# OPENROUTER_TTS_TIMEOUT_SECONDS=300
# OPENROUTER_VIDEO_DURATION=90   # seconds (8–120; provider may clamp; ~1.5 min default)
# OPENROUTER_VIDEO_RESOLUTION=720p
# OPENROUTER_VIDEO_ASPECT_RATIO=16:9
# OPENROUTER_VIDEO_GENERATE_AUDIO=true
# OPENROUTER_VIDEO_POLL_INTERVAL=5
# OPENROUTER_VIDEO_TIMEOUT_SECONDS=1800

# ── Manus AI (optional) ──────────────────────────────────────
# When OPENROUTER_API_KEY is unset and MANUS_API_KEY is set, /audio/narrate can use Manus for TTS.
# MANUS_API_KEY=
# MANUS_API_BASE=https://api.manus.ai
# MANUS_TTS_TIMEOUT_SECONDS=480
# MANUS_AGENT_PROFILE=manus-1.6-lite

# ── Stripe ───────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → your endpoint → signing secret
# Omit until the endpoint exists: production boot allows empty; /stripe/webhook returns 503 until set.
STRIPE_WEBHOOK_SECRET=whsec_...

# Dashboard → Products → create two recurring prices:
#   Pro plan:    $19 / month → 15 summaries / month
#   Growth plan: $25 / month → 25 summaries / month
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_GROWTH=price_...

# Stripe Checkout redirect URLs
STRIPE_SUCCESS_URL=http://localhost:8000/frontend/dashboard.html
STRIPE_CANCEL_URL=http://localhost:8000/frontend/index.html

# ── Webhook testing (local) ───────────────────────────────────
# Install Stripe CLI, then run:
#   stripe listen --forward-to http://localhost:8000/stripe/webhook
# Required Stripe events:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted

# ── Public URL ───────────────────────────────────────────────
# Used for Stripe return URLs. On Render this is set automatically
# via RENDER_EXTERNAL_URL; you only need to set PUBLIC_APP_URL locally.
PUBLIC_APP_URL=http://localhost:8000
# RENDER_EXTERNAL_URL=https://your-service.onrender.com  ← set by Render
