# ============================================================
# BookBrief AI — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=BookBrief AI
DEBUG=false
# Long random string — used for general signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated allowed CORS origins (no trailing slash)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Database ─────────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL=sqlite:///./bookbrief.db
# PostgreSQL for production (Render sets DATABASE_URL automatically):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/bookbrief

# ── JWT Auth ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
# Token lifetime in minutes (default 7 days = 10080)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# gpt-4o for best quality, gpt-4o-mini for cost savings
OPENAI_MODEL=gpt-4o-mini

# ── Manus AI (optional) ──────────────────────────────────────
# When MANUS_API_KEY is set, /audio/narrate uses Manus tasks for TTS (audiobook + podcast segments).
# Otherwise narration uses OpenAI TTS. Never commit real keys — copy this file to .env locally.
MANUS_API_KEY=sk-xiCH5_Ba4rO4BlEH7HY-KySq_ChL3-KL4-1U7hqHbHlCDM8UGCN6geB-ePhspWZYWrF3Skx6xQhhpEyWLf_T0GQhNsie
MANUS_API_BASE=https://api.manus.ai
MANUS_TTS_TIMEOUT_SECONDS=480
MANUS_AGENT_PROFILE=manus-1.6-lite
# Video summaries (Manus task — can take many minutes)
MANUS_VIDEO_TIMEOUT_SECONDS=900
MANUS_VIDEO_AGENT_PROFILE=manus-1.6

# ── Stripe ───────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → your endpoint → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Dashboard → Products → create two recurring prices:
#   Pro plan:    $19 / month → 15 summaries / month
#   Growth plan: $25 / month → 25 summaries / month
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_GROWTH=price_...

# Stripe Checkout redirect URLs
STRIPE_SUCCESS_URL=http://localhost:8000/frontend/dashboard.html
STRIPE_CANCEL_URL=http://localhost:8000/frontend/index.html

# ── Webhook testing (local) ───────────────────────────────────
# Install Stripe CLI, then run:
#   stripe listen --forward-to http://localhost:8000/stripe/webhook
# Required Stripe events:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted

# ── Public URL ───────────────────────────────────────────────
# Used for Stripe return URLs. On Render this is set automatically
# via RENDER_EXTERNAL_URL; you only need to set PUBLIC_APP_URL locally.
PUBLIC_APP_URL=http://localhost:8000
# RENDER_EXTERNAL_URL=https://your-service.onrender.com  ← set by Render
