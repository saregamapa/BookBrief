# BookBrief AI — copy to .env and fill values

# App
APP_NAME=BookBrief AI
DEBUG=false
# When true, POST /auth/forgot-password includes reset_token in the response (no email yet).
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database: SQLite (dev) or PostgreSQL (prod)
# SQLite:
DATABASE_URL=sqlite:///./bookbrief.db
# PostgreSQL (production on Render, etc.):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Stripe (Dashboard → Products → create recurring prices for Pro / Unlimited)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_UNLIMITED=price_...
STRIPE_SUCCESS_URL=http://localhost:8000/frontend/dashboard.html
STRIPE_CANCEL_URL=http://localhost:8000/frontend/index.html
# Webhook endpoint URL (Stripe CLI local: stripe listen --forward-to localhost:8000/stripe/webhook)
# Production: https://YOUR_HOST/stripe/webhook — events: checkout.session.completed, customer.subscription.*

# Frontend base URL (Stripe return URLs, portal). On Render, omit to use RENDER_EXTERNAL_URL.
PUBLIC_APP_URL=http://localhost:8000
# Set automatically on Render web services (https://your-service.onrender.com).
# RENDER_EXTERNAL_URL=
