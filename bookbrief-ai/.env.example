# BookBrief AI — minimal env sample. Prefer the fuller template:
#   bookbrief-ai/backend/.env.example
# Copy to bookbrief-ai/backend/.env before running uvicorn from backend/.

DEBUG=true
SECRET_KEY=dev-only-change-me-in-production
JWT_SECRET_KEY=dev-only-jwt-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./bookbrief.db
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PUBLIC_APP_URL=http://localhost:8000

OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_SUMMARY_MODEL=google/gemma-4-26b-a4b-it
# OPENROUTER_PODCAST_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts
# OPENROUTER_VIDEO_MODEL=google/veo-3.1-lite

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_SUCCESS_URL=http://localhost:8000/frontend/dashboard.html?payment=success
STRIPE_CANCEL_URL=http://localhost:8000/frontend/dashboard.html?payment=cancelled
