# ─────────────────────────────────────────────────────────────────────────────
# BookBrief AI — Environment Variables
# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Set DEBUG=false in production. When false, the startup validator will
# refuse to start if any required secrets are still at their dev defaults.
DEBUG=true

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me-in-production
JWT_SECRET_KEY=dev-only-jwt-change-me
JWT_ALGORITHM=HS256
# Token lifetime in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev. In production use a PostgreSQL URL:
#   postgresql+asyncpg://user:password@host:5432/bookbrief
DATABASE_URL=sqlite:///./bookbrief.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Public URL ───────────────────────────────────────────────────────────────
# Used for Stripe redirect URLs and absolute link generation.
PUBLIC_APP_URL=http://localhost:8000
# Set automatically by Render; leave blank locally.
# RENDER_EXTERNAL_URL=

# ── OpenAI ───────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Stripe ───────────────────────────────────────────────────────────────────
# Test keys start with sk_test_ / whsec_test_
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from your Stripe product catalog (Dashboard → Products)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_GROWTH=price_...

# Redirect URLs after Stripe Checkout / Billing Portal
STRIPE_SUCCESS_URL=http://localhost:8000/frontend/dashboard.html?payment=success
STRIPE_CANCEL_URL=http://localhost:8000/frontend/dashboard.html?payment=cancelled
